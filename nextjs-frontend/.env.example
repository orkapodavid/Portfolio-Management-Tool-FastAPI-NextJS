# Web backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Desktop values are injected automatically by the Tauri helper scripts.
# Keep these at their defaults unless you need to override local desktop startup.
NEXT_PUBLIC_DESKTOP_TARGET=0
NEXT_PUBLIC_DESKTOP_API_BASE_URL=http://127.0.0.1:18475

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json

# Dev-only: bypass the dashboard auth gate so pages load without logging in.
# Pair with PMT_AUTH_DISABLED on the backend. Never enable in production.
NEXT_PUBLIC_AUTH_DISABLED=0
